# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMS QRIS Internal Backend Configuration
PORT=3000
DATABASE_URL="file:./database/adms_qris.sqlite"
JWT_SECRET="adms_qris_internal_secret_key_2026_super_secure_jwt"
FRONTEND_URL="http://localhost:3000"

# Payment Provider Config (mock or dana)
PAYMENT_PROVIDER="mock"

# DANA Payment Gateway (SNAP) Configuration
DANA_ENVIRONMENT="sandbox"
DANA_MERCHANT_ID=""
DANA_X_PARTNER_ID=""
DANA_PRIVATE_KEY=""
DANA_PUBLIC_KEY=""
DANA_CLIENT_SECRET=""
DANA_EXTERNAL_STORE_ID=""

